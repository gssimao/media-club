# Admin account (seeded automatically on first run when no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Landing page when visiting / (optional)
# Examples: /login, /movies, /books, /music — leave empty or set to / for the welcome page
DEFAULT_ROUTE=

# Metadata APIs (server-side only)
TMDB_API_KEY=
DISCOGS_TOKEN=

# MCP server (LLM clients — Bearer token for /mcp)
MCP_API_KEY=

# Local / Docker SQLite
DATABASE_URL=file:./data/media-club.db

# Cloudflare D1 (remote migrations via drizzle-kit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Dev-only: set DRIZZLE_LOCAL=1 to point drizzle-kit at local SQLite.
# Docker and Cloudflare deployments do not use this flag.
DRIZZLE_LOCAL=1
