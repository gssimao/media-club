# ── Admin (required for production; used when seeding the first admin account) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── Landing page (optional) ──
# Redirect / to this path, e.g. /login, /movies, /books, /music
# Leave empty or set to / for the welcome page
DEFAULT_ROUTE=

# ── Metadata APIs (server-side only; optional for browse-only setups) ──
# Movies: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Music: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
# Books use Open Library — no key needed

# ── MCP server (optional — LLM clients calling /mcp) ──
MCP_API_KEY=

# ── Local / Docker SQLite ──
DATABASE_URL=file:./data/media-club.db

# ── Cloudflare D1 (remote migrations + deploy) ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
# Optional — used by scripts/deploy-cloudflare.mjs (defaults shown)
# CLOUDFLARE_CUSTOM_DOMAIN=mediaclub.gssimao.com
# CLOUDFLARE_ZONE_NAME=gssimao.com

# ── Drizzle CLI ──
# Set DRIZZLE_LOCAL=1 so drizzle-kit uses ./data/media-club.db (local dev).
# Docker and Cloudflare deployments do not use this flag.
DRIZZLE_LOCAL=1
