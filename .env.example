# App secrets
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=replace-with-a-long-random-string

# Metadata APIs (server-side only)
TMDB_API_KEY=
DISCOGS_TOKEN=

# Local / Docker SQLite
DATABASE_URL=file:./data/media-club.db

# Cloudflare D1 (remote migrations via drizzle-kit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Set DRIZZLE_LOCAL=1 to run migrations against local SQLite
DRIZZLE_LOCAL=1
